# Bu dosyayı .env olarak kopyalayın. .env ASLA git'e girmez.
ENV=dev
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///./var/atolye.db
# Lokal geliştirmede http kullanıldığı için false; production'da true olmalı
COOKIE_SECURE=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]
MEDIA_ROOT=./var/media
MAX_UPLOAD_MB=5
# Ödeme sağlayıcı webhook imza anahtarı (boşsa webhook kapalı)
PAYMENT_WEBHOOK_SECRET=
# Bildirim kanalı: console | sms | whatsapp. Anahtarları ASLA commit etmeyin.
NOTIFY_CHANNEL=console
SMS_API_URL=
SMS_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# --- Production (docker compose) ---
# ENV=prod
# COOKIE_SECURE=true
# DATABASE_URL=postgresql+psycopg://atolye:${POSTGRES_PASSWORD}@db:5432/atolye
# ALLOWED_HOSTS=["panel.ornekalan.com"]
# POSTGRES_PASSWORD=
# DOMAIN=panel.ornekalan.com

# H3 — gerçek e-posta gönderimi için SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# H4 — Abonelik ödemesi: fake (anahtarsız demo) | iyzico | paytr
# PAYMENT_LIVE=false iken iyzico yalnız sandbox, PayTR yalnız TEST_MODE=1 ile açılır. Kimse true yapmaz (KARARLAR.md).
PAYMENT_PROVIDER=fake
PAYMENT_LIVE=false
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
# Ödeme dönüş adresleri için dışarıdan erişilen adres (boşsa istekten alınır)
PUBLIC_BASE_URL=
